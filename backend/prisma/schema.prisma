generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- ENUMS ----------

enum Role {
  ADMIN
  RESIDENT_ENGINEER
}

enum ProjectType {
  STADIUM
  POOL
  SYNTHETIC_FIELD
  RETAINING_WALL
  PRIVATE_WORK
  OTHER
  RESIDENTIAL_BUILDING
  COMMERCIAL_BUILDING
  ROAD
  BRIDGE
  SCHOOL
  HEALTH_CENTER
  WAREHOUSE
  REMODELING
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  SUSPENDED
  FINISHED
}

enum WorkerStatus {
  ACTIVE
  INACTIVE
}

enum MovementType {
  IN
  OUT
}

enum ExpenseCategory {
  MATERIALS
  LABOR
  EQUIPMENT
  TRANSPORT
  FUEL
  OTHER
}

enum IncidentType {
  MATERIAL_SHORTAGE
  ACTIVITY_DELAY
  WEATHER
  EQUIPMENT_DAMAGE
  STAFF_ISSUE
  ACTIVITY_CHANGE
  OTHER
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  CHECK
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaterialCategory {
  CEMENT_CONCRETE
  STEEL
  AGGREGATES
  MASONRY
  WOOD
  ELECTRICAL
  PLUMBING
  FINISHES
  TOOLS_EQUIPMENT
  OTHER
}

enum Weather {
  SUNNY
  CLOUDY
  RAINY
  STORMY
}

enum FieldReportStatus {
  SUBMITTED
  REVIEWED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum AlertType {
  INVENTORY
  SCHEDULE
  FINANCIAL
  ACTIVITY
}

enum AlertStatus {
  ACTIVE
  RESOLVED
}

enum PredictionType {
  DELAY_RISK
  COST_OVERRUN_RISK
  ANOMALY
  MATERIAL_FORECAST
  PRIORITY_SCORE
}

// ---------- MODELS ----------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(RESIDENT_ENGINEER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Users module (additive: defaults keep existing users active, no forced change) ---
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  mustChangePassword Boolean   @default(false)
  phone              String?
  createdById        String?
  createdBy          User?     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deactivatedAt      DateTime?

  projectsInCharge Project[]      @relation("ProjectResponsible")
  activities       Activity[]     @relation("ActivityResponsible")
  evidenceUploaded Evidence[]     @relation("EvidenceUploadedBy")
  refreshTokens    RefreshToken[]

  expensesRegistered    Expense[]      @relation("ExpenseRegisteredBy")
  expensesReviewed      Expense[]      @relation("ExpenseReviewedBy")
  fundTransfersReceived FundTransfer[] @relation("FundTransferResident")
  fundTransfersCreated  FundTransfer[] @relation("FundTransferCreatedBy")

  movementsRegistered  InventoryMovement[] @relation("MovementRegisteredBy")
  fieldReportsAuthored FieldReport[]       @relation("FieldReportAuthor")
  fieldReportsReviewed FieldReport[]       @relation("FieldReportReviewer")

  usersCreated          User[]                 @relation("UserCreatedBy")
  auditLogs             AuditLog[]             @relation("AuditActor")
  settingsUpdated       SystemSetting[]        @relation("SettingUpdatedBy")
  incidentsReported     Incident[]             @relation("IncidentReportedBy")
  incidentsResolved     Incident[]             @relation("IncidentResolvedBy")
  incidentStatusChanges IncidentStatusChange[] @relation("IncidentStatusChangedBy")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Project {
  id                 String        @id @default(uuid())
  name               String
  type               ProjectType
  municipality       String
  address            String?
  startDate          DateTime
  estimatedEndDate   DateTime
  budget             Decimal       @db.Decimal(14, 2)
  status             ProjectStatus @default(PLANNED)
  progressPercentage Float         @default(0)
  responsibleId      String
  responsible        User          @relation("ProjectResponsible", fields: [responsibleId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  activities         Activity[]
  workers            Worker[]
  inventoryMovements InventoryMovement[]
  expenses           Expense[]
  incidents          Incident[]
  evidence           Evidence[]
  alerts             Alert[]
  predictions        Prediction[]
  fundTransfers      FundTransfer[]
  fieldReports       FieldReport[]

  @@map("projects")
}

model Activity {
  id                 String   @id @default(uuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date               DateTime
  name               String
  description        String?
  progressPercentage Float
  responsibleId      String
  responsible        User     @relation("ActivityResponsible", fields: [responsibleId], references: [id])
  observations       String?
  createdAt          DateTime @default(now())

  evidence Evidence[]

  @@map("activities")
}

model Worker {
  id         String       @id @default(uuid())
  name       String
  documentId String       @unique
  position   String
  projectId  String?
  project    Project?     @relation(fields: [projectId], references: [id])
  status     WorkerStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  /// Sensitive personal data: only returned to admins
  phone      String?

  @@map("workers")
}

model Material {
  id             String            @id @default(uuid())
  name           String
  unit           String
  stockAvailable Float             @default(0)
  stockMinimum   Float             @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  // Inventory module (additive): null = "no category" for existing materials
  category       MaterialCategory?

  movements InventoryMovement[]

  @@map("materials")
}

model InventoryMovement {
  id         String       @id @default(uuid())
  materialId String
  material   Material     @relation(fields: [materialId], references: [id])
  projectId  String?
  project    Project?     @relation(fields: [projectId], references: [id])
  type       MovementType
  quantity   Float
  date       DateTime     @default(now())
  notes      String?

  // --- Inventory module (additive: nullable or defaulted) ---
  registeredById String?
  registeredBy   User?     @relation("MovementRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  expenseId      String?
  expense        Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  unitCost       Decimal?  @db.Decimal(14, 2)
  createdAt      DateTime  @default(now())

  @@index([materialId, date])
  @@index([projectId, date])
  @@index([expenseId])
  @@index([registeredById])
  @@map("inventory_movements")
}

model Expense {
  id          String          @id @default(uuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(14, 2)
  date        DateTime        @default(now())
  description String?

  // --- Finance module (additive: every column is nullable or has a default) ---
  supplierId         String?
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  paymentMethod      PaymentMethod?
  invoiceNumber      String?
  supportUrl         String?
  registeredById     String?
  registeredBy       User?               @relation("ExpenseRegisteredBy", fields: [registeredById], references: [id])
  // APPROVED by default so expenses created before this module keep counting
  status             ExpenseStatus       @default(APPROVED)
  reviewedById       String?
  reviewedBy         User?               @relation("ExpenseReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime            @default(now())
  inventoryMovements InventoryMovement[]

  @@index([projectId, date])
  @@index([registeredById])
  @@index([status])
  @@index([supplierId])
  @@map("expenses")
}

model Supplier {
  id        String           @id @default(uuid())
  name      String
  // Colombian tax id; optional, unique when present (Postgres allows many NULLs)
  nit       String?          @unique
  category  ExpenseCategory?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  expenses  Expense[]
  movements InventoryMovement[]

  @@index([name])
  @@map("suppliers")
}

/// Money the ADMIN sends to a resident engineer for field expenses.
model FundTransfer {
  id          String         @id @default(uuid())
  residentId  String
  resident    User           @relation("FundTransferResident", fields: [residentId], references: [id])
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  amount      Decimal        @db.Decimal(14, 2)
  date        DateTime       @default(now())
  method      PaymentMethod?
  notes       String?
  createdById String
  createdBy   User           @relation("FundTransferCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())

  @@index([residentId])
  @@index([projectId, date])
  @@index([date])
  @@map("fund_transfers")
}

model Incident {
  id          String         @id @default(uuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime       @default(now())
  type        IncidentType
  description String
  priority    Priority       @default(MEDIUM)
  status      IncidentStatus @default(OPEN)

  // --- Incidents module (additive; existing rows keep their status) ---
  reportedById   String?
  reportedBy     User?     @relation("IncidentReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?     @relation("IncidentResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?
  createdAt      DateTime  @default(now())

  statusChanges IncidentStatusChange[]
  evidence      Evidence[]

  @@index([projectId, status])
  @@map("incidents")
}

model Evidence {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityId   String?
  activity     Activity? @relation(fields: [activityId], references: [id])
  date         DateTime  @default(now())
  description  String?
  imageUrl     String
  uploadedById String
  uploadedBy   User      @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id])
  /// Optional link so an incident can carry photos (SET NULL keeps the photo if the link goes)
  incidentId   String?
  incident     Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([incidentId])
  @@map("evidence")
}

model Alert {
  id        String      @id @default(uuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      AlertType
  message   String
  severity  Priority    @default(MEDIUM)
  status    AlertStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  // Numbers behind the message so the UI can render it in any language
  params    Json?

  @@map("alerts")
}

model Prediction {
  id          String         @id @default(uuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        PredictionType
  resultJson  Json
  confidence  Float?
  generatedAt DateTime       @default(now())

  @@map("predictions")
}

/// Daily site log: one per project and business day (America/Bogota).
model FieldReport {
  id            String            @id @default(uuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  authorId      String
  author        User              @relation("FieldReportAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  date          DateTime          @db.Date
  weather       Weather?
  workersOnSite Int?
  summary       String
  issues        String?
  status        FieldReportStatus @default(SUBMITTED)
  reviewedById  String?
  reviewedBy    User?             @relation("FieldReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([projectId, date])
  @@index([authorId])
  @@index([date])
  @@map("field_reports")
}

/// Who moved an incident between states and why. Rows are part of the incident:
/// they follow it if its project is ever deleted (incidents already cascade from projects).
model IncidentStatusChange {
  id          String          @id @default(uuid())
  incidentId  String
  incident    Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fromStatus  IncidentStatus?
  toStatus    IncidentStatus
  changedById String?
  changedBy   User?           @relation("IncidentStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime        @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_status_changes")
}

/// Append-only system history. actorEmail is a snapshot so the row stays readable
/// if the user is ever removed (actorId is SET NULL). metadata never holds secrets.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

/// Only the settings an admin customised; missing keys fall back to code defaults.
model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedBy   User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}
